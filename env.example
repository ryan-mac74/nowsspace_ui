# ------------
# Service URLs
# ------------

NEXT_PUBLIC_UI_URL=http://localhost:3100
NEXT_PUBLIC_SDK_URL=http://localhost:8100/api
NEXT_PUBLIC_WS_URL=ws://localhost:8100/ws

# -----------
# Token Setup
# -----------

NEXT_PUBLIC_TOKEN_KEY=token

