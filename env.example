PORT=3100
NEXT_PUBLIC_ENV=development

NEXT_PUBLIC_DOMAIN_NAME=localhost
NEXT_PUBLIC_ALLOWED_HOSTS="http://localhost:3100, http://localhost:5173"

# ------------
# Project Info
# ------------

NEXT_PUBLIC_PROJECT_NAME=NowSSpace

NEXT_PUBLIC_APP_TITLE="NowSSpace - Real-time sync App"
